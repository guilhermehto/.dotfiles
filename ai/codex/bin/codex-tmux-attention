#!/bin/sh

set -u

state="${1:-}"

case "$state" in
  waiting|active|clear) ;;
  *)
    printf 'codex-tmux-attention: unknown state: %s\n' "$state" >&2
    exit 1
    ;;
esac

if [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
  window_id="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)"

  if [ -n "$window_id" ]; then
    case "$state" in
      waiting)
        tmux set-option -w -t "$window_id" @codex_attention waiting
        ;;
      active|clear)
        tmux set-option -wu -t "$window_id" @codex_attention 2>/dev/null || true
        ;;
    esac
  fi
fi

review_handler="$HOME/.config/work/plugins/prs-review.py"
if { [ -n "${PRQ_REVIEW_DIR:-}" ] || [ -f .prq-review.json ]; } && [ -f "$review_handler" ]; then
  python3 -B "$review_handler" hook || printf 'Could not update PR review status.\n' >&2
fi

# Stop hooks require JSON on stdout; an empty object is a successful no-op.
printf '{}\n'
